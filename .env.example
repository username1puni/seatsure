# Copy to .env and fill in. Never commit the real .env.

# Database
DB_USERNAME=seatsure
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# JWT signing key, at least 32 characters (e.g. openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_MINUTES=1440

# Signs the QR code on tickets
TICKET_SECRET=replace-with-another-random-string

# First admin account, created on startup if it does not exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# Fill the database with demo cities, theatres, movies and shows on first start
SEED_DEMO_DATA=true

# How long seats stay held while the user pays
HOLD_MINUTES=5

# Payments: "mock" works out of the box. For Razorpay test mode set PAYMENT_GATEWAY=razorpay
# and the test keys from https://dashboard.razorpay.com/app/keys
PAYMENT_GATEWAY=mock
MOCK_PAYMENT_SECRET=replace-me
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: email tickets. Leave MAIL_HOST empty to skip (tickets can still be downloaded).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=SeatSure <no-reply@example.com>

# Browser origins allowed to call the API and open the WebSocket. Add your public URL when the app
# runs behind a reverse proxy or on a domain, e.g. https://tickets.example.com
CORS_ORIGINS=http://localhost:5173
